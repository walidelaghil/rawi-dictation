# Copy to ~/.config/rawi/.env (or paste the key in Rawi's setup, which writes
# this file for you). Readable only by you: chmod 600 ~/.config/rawi/.env
#
# This file is read only by Rawi, is never logged, and is never sent anywhere
# except the provider it belongs to.

# --- Groq: the default, and the only key most people need ---
# One key covers transcription, cleanup/polish, transforms and paragraphs.
# Free tier at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional alternatives ---
# With no Groq key, Rawi uses whisper.cpp on this Mac if it is installed
# (engine "whispercpp"), and cleanup through Ollama, OpenAI or Anthropic.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
