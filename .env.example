# Copy to ~/.config/rawi/.env and fill in only what you need.
# Every key is optional. With none of them set, Rawi runs fully offline
# using local whisper.cpp and no LLM cleanup.
#
# This file is read only by Rawi, is never logged, and is never sent
# anywhere except the provider it belongs to.

# --- Transcription (only if engine is "groq" or "openai") ---
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# --- Cleanup LLM (only if cleanup.provider is "openai" or "anthropic") ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
